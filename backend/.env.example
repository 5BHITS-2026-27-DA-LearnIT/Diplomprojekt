# Vorlage für die Umgebungsvariablen des Backends.
# Kopieren nach .env und Werte anpassen. Die echte .env nie committen!

# --- Django ---
# Pflicht. Neuen Schlüssel erzeugen mit:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=bitte-aendern
# True nur in der Entwicklung. Standard: False
DJANGO_DEBUG=False
# Kommagetrennt, z. B. localhost,127.0.0.1,lernplattform.schule.at
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
# Dieselben Namen wie beim offiziellen postgres-Docker-Image.
# Ist POSTGRES_DB leer/nicht gesetzt, nutzt Django lokal SQLite.
POSTGRES_DB=lernplattform
POSTGRES_USER=lernplattform
POSTGRES_PASSWORD=bitte-aendern
# Name des Datenbank-Containers in docker-compose (Standard: db)
POSTGRES_HOST=db
POSTGRES_PORT=5432
